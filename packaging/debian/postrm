#!/bin/sh
set -e
case "$1" in
  remove|purge) ;;
  *) exit 0 ;;
esac
# No eliminar perfiles, claves ni metadatos del usuario.
if command -v python3 >/dev/null 2>&1; then
/usr/bin/python3 -I - <<'PY'
from pathlib import Path
import os, re, stat, subprocess, tempfile
for path in Path('/etc/sudoers.d').glob('vpn-manager-*'):
    if not re.fullmatch(r'vpn-manager-[0-9]+', path.name):
        continue
    info = path.lstat()
    if stat.S_ISREG(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022:
        if path.read_bytes().startswith(b'# Managed by VPN Manager:'):
            path.unlink()
local = Path('/etc/apparmor.d/local/wg-quick')
profile = Path('/etc/apparmor.d/wg-quick')
parser = Path('/usr/sbin/apparmor_parser')
if local.exists() and not local.is_symlink():
    info = local.stat()
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise SystemExit('No se modificó el ajuste AppArmor: permisos inseguros.')
    old = local.read_bytes()
    begin = b'# BEGIN VPN Manager: WireGuard access\n'
    end = b'# END VPN Manager: WireGuard access\n'
    if old.count(begin) == 1 and old.count(end) == 1:
        start, stop = old.index(begin), old.index(end) + len(end)
        if stop < start:
            raise SystemExit('Bloque AppArmor inválido; se conserva.')
        new = old[:start] + old[stop:]
        def write(data):
            fd, name = tempfile.mkstemp(prefix='.vpn-manager-', dir=local.parent)
            try:
                with os.fdopen(fd, 'wb') as stream:
                    os.fchmod(stream.fileno(), stat.S_IMODE(info.st_mode))
                    stream.write(data)
                os.replace(name, local)
            finally:
                Path(name).unlink(missing_ok=True)
        write(new)
        try:
            if profile.exists() and parser.exists():
                for flags in (['-Q', '-K'], ['-r', '-K']):
                    subprocess.run([str(parser), *flags, str(profile)], check=True,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
        except Exception:
            write(old)
            if profile.exists() and parser.exists():
                subprocess.run([str(parser), '-r', '-K', str(profile)],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
            raise SystemExit('Se restauró el ajuste AppArmor tras un fallo de recarga.')
PY
fi
exit 0
